---
import SiteLayout from '../layouts/SiteLayout.astro';
import ActivityDemo from '../components/ActivityDemo.astro';
import { APP_STORE_URL, pathFor } from '../config/site';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: 'Golden Moments',
  applicationCategory: 'GameApplication',
  operatingSystem: 'iOS, iPadOS',
  url: APP_STORE_URL,
  description: 'A calm picture matching game with familiar images, easy taps, and no time pressure.'
};
---
<SiteLayout description="A calm picture matching game for older adults and families. Explore familiar pictures, easy taps, and no-rush activities to enjoy together.">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
  <section class="hero" aria-labelledby="hero-title">
    <div class="page-shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> A gentler kind of picture game</p>
        <h1 id="hero-title">A little time together.<span> A moment worth keeping.</span></h1>
        <p class="hero-lede">Familiar pictures, large easy-to-tap tiles, and absolutely no rush. Golden Moments makes room for a simple activity to enjoy with someone you love.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="23" height="23" fill="none" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M10 18h4" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"/></svg>
            Get the iPhone & iPad app
          </a>
          <a class="button button-text" href="#how-it-works">See how it works <span aria-hidden="true">↗</span></a>
        </div>
        <p class="small-print">Free to download on the App Store. Availability and features depend on the installed version.</p>
      </div>
      <ActivityDemo />
    </div>
  </section>

  <section class="quiet-ribbon" aria-label="What makes Golden Moments gentle">
    <div class="page-shell ribbon-grid">
      <div><span class="ribbon-glyph" aria-hidden="true">◇</span><span>Large, easy-to-see pictures</span></div>
      <div><span class="ribbon-glyph" aria-hidden="true">○</span><span>Play at your own pace</span></div>
      <div><span class="ribbon-glyph" aria-hidden="true">✳</span><span>Enjoy on your own or together</span></div>
    </div>
  </section>

  <section class="section-space" id="how-it-works" aria-labelledby="how-title">
    <div class="page-shell">
      <div class="section-intro">
        <p class="eyebrow">01 / A simple beginning</p>
        <h2 id="how-title">A good moment doesn't need instructions.</h2>
        <p>Open a game. Find two pictures that go together. Or simply take a little time with the images. That's enough.</p>
      </div>
      <div class="step-grid">
        <article class="step">
          <span class="step-number">01</span>
          <div class="step-icon" aria-hidden="true"><svg viewBox="0 0 72 72"><rect x="8" y="11" width="56" height="50" rx="10" fill="#FFE08A" stroke="#7A5600" stroke-width="2"/><path d="M22 25h28M22 36h20M22 47h15" stroke="#7A5600" stroke-width="3" stroke-linecap="round"/></svg></div>
          <h3>Choose a picture game</h3>
          <p>Start with something familiar. There is no complicated setup to enjoy the basic game.</p>
        </article>
        <article class="step">
          <span class="step-number">02</span>
          <div class="step-icon" aria-hidden="true"><svg viewBox="0 0 72 72"><rect x="10" y="12" width="31" height="31" rx="7" fill="#F5EDE0" stroke="#7A5600" stroke-width="2"/><rect x="31" y="29" width="31" height="31" rx="7" fill="#FFE08A" stroke="#7A5600" stroke-width="2"/><path d="m40 44 6 6 10-12" fill="none" stroke="#7A5600" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <h3>Find a matching pair</h3>
          <p>Tap one picture, then another. Take all the time you need—nothing is timed.</p>
        </article>
        <article class="step">
          <span class="step-number">03</span>
          <div class="step-icon" aria-hidden="true"><svg viewBox="0 0 72 72"><path d="M13 16h46v33H38L25 59V49H13z" fill="#F5EDE0" stroke="#7A5600" stroke-width="2.5" stroke-linejoin="round"/><path d="M24 31h24M24 39h14" stroke="#7A5600" stroke-width="3" stroke-linecap="round"/></svg></div>
          <h3>Share a thought—or not</h3>
          <p>A picture might bring a story to mind. It is just as lovely to look quietly together.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-space feature-section" id="features" aria-labelledby="feature-title">
    <div class="page-shell">
      <div class="feature-heading">
        <div>
          <p class="eyebrow">02 / Thoughtful by design</p>
          <h2 id="feature-title">The small details make all the difference.</h2>
        </div>
        <p>Golden Moments is designed to feel like opening a well-loved picture book: clear, familiar, and unhurried.</p>
      </div>
      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-line" aria-hidden="true"></div>
          <span class="feature-symbol" aria-hidden="true">01</span>
          <h3>See it clearly</h3>
          <p>Large pictures, distinct shapes, and a gentle visual style make the game easy to follow.</p>
        </article>
        <article class="feature-card">
          <div class="feature-line" aria-hidden="true"></div>
          <span class="feature-symbol" aria-hidden="true">02</span>
          <h3>Keep your own pace</h3>
          <p>No countdown and no need to finish. A few easy moments are enough.</p>
        </article>
        <article class="feature-card">
          <div class="feature-line" aria-hidden="true"></div>
          <span class="feature-symbol" aria-hidden="true">03</span>
          <h3>Find familiar things</h3>
          <p>Explore classic objects and recognizable subjects that can invite conversation.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-space memory-section" aria-labelledby="memory-title">
    <div class="page-shell memory-grid">
      <div class="memory-art" aria-hidden="true">
        <div class="memory-art-outline"></div>
        <div class="memory-art-card card-back"><img src={pathFor('/illustrations/sunflower.svg')} alt="" width="236" height="236" loading="lazy" /></div>
        <div class="memory-art-card card-front"><img src={pathFor('/illustrations/teacup.svg')} alt="" width="236" height="236" loading="lazy" /></div>
      </div>
      <div class="memory-copy">
        <p class="eyebrow">03 / A little more personal</p>
        <h2 id="memory-title">The pictures that matter most are often your own.</h2>
        <p>We're developing a way to choose your own family photographs for gentle activities on your device.</p>
        <div class="planned-note">
          <strong>In development</strong>
          <span>Personal-photo activities are not in the currently published App Store version. No family-photo syncing service is offered.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section-space caregiver-section" aria-labelledby="caregiver-title">
    <div class="page-shell caregiver-grid">
      <div>
        <p class="eyebrow">For families and caregivers</p>
        <h2 id="caregiver-title">When someone you love is living with dementia, simply being together matters.</h2>
      </div>
      <div>
        <p>Gentle picture games can be one way to spend time together. Follow the person's interests, offer choices, and change activities whenever they want to.</p>
        <p>Golden Moments is for recreation and shared conversation. It is not a treatment, memory assessment, or substitute for professional care.</p>
        <a class="text-link" href={pathFor('/activities/')}>Read our gentle activity ideas <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section-space questions-section" id="questions" aria-labelledby="questions-title">
    <div class="page-shell questions-grid">
      <div>
        <p class="eyebrow">A few good questions</p>
        <h2 id="questions-title">The simple answers.</h2>
        <p>Something missing? <a href={pathFor('/support/')}>We're happy to help.</a></p>
      </div>
      <div class="faq-list">
        <details>
          <summary>Is Golden Moments a dementia treatment?<span class="plus" aria-hidden="true"></span></summary>
          <p>No. Golden Moments offers simple picture games for enjoyment and shared time. It does not diagnose, treat, prevent, or measure dementia or Alzheimer's disease.</p>
        </details>
        <details>
          <summary>Do I have to be good at games?<span class="plus" aria-hidden="true"></span></summary>
          <p>Not at all. There is no time limit. You can play at the pace that feels comfortable, stop whenever you like, and enjoy the pictures together.</p>
        </details>
        <details>
          <summary>Can I play on an iPad?<span class="plus" aria-hidden="true"></span></summary>
          <p>Yes. Golden Moments is listed for compatible iPhone and iPad devices. Check the App Store page for current requirements.</p>
        </details>
        <details>
          <summary>Can I use my own family photos?<span class="plus" aria-hidden="true"></span></summary>
          <p>This feature is in development and is not included in the currently published App Store version. When available, the proposed flow will use photos you explicitly select, without a family-sync account.</p>
        </details>
        <details>
          <summary>Does this website collect my photos?<span class="plus" aria-hidden="true"></span></summary>
          <p>No. The small example game on this website uses only its own illustrations. There is no photo upload, account, or tracking script. Read our <a href={pathFor('/privacy/')}>website privacy note</a>.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <div class="page-shell closing-inner">
      <span class="closing-emblem" aria-hidden="true">✳</span>
      <h2 id="closing-title">A little time together is a lovely place to start.</h2>
      <p>Open Golden Moments whenever you feel like sharing a quiet picture game.</p>
      <a class="button button-primary" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">Find Golden Moments on the App Store <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</SiteLayout>
