---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pathFor } from '../config/site';
---
<SiteLayout title="Page not found" description="That page isn't here, but you can always find your way back to Golden Moments." noindex>
  <section class="interior-hero not-found">
    <div class="reading-column">
      <p class="eyebrow">A small detour</p>
      <h1>That page isn't here.</h1>
      <p class="interior-lede">It's all right. You can go back to the beginning.</p>
      <a class="button button-primary" href={pathFor('/')}>Return to Golden Moments <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>
